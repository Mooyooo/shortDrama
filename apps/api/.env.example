# shortDrama API settings. Copy to .env; never commit .env.
PORT=3101
DATABASE_URL=postgresql://localhost/shortdrama_dev

# Local development only: play public test videos for series loaded by `npm run seed:dev`.
# The API refuses to start with this on when NODE_ENV=production.
DEV_SAMPLE_VIDEOS=false

# Interim admin protection until staff accounts exist: a long random string.
ADMIN_TOKEN=

# Cloudflare Stream (same Cloudflare account as socialManager). Leave empty to run without video.
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
# The <CODE> in https://customer-<CODE>.cloudflarestream.com
CF_STREAM_CUSTOMER_CODE=
# From POST /accounts/<id>/stream/keys: the key id and its base64 PEM.
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
# Shown once when the webhook URL is registered.
CF_STREAM_WEBHOOK_SECRET=
PLAYBACK_TTL_SECONDS=14400
